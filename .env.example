# Settings are read from the process environment, not automatically from this file.
# Local mode generates its own ignored .local/secret_key; do not paste secrets here.
APP_ENV=local
DEBUG=false
# Production requires a unique DJANGO_SECRET_KEY (50+ random characters).
# DJANGO_ALLOWED_HOSTS=your-explicit-hostname
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-explicit-hostname
# ANALYZER_API_TOKEN is optional and is used only by local integration clients.
